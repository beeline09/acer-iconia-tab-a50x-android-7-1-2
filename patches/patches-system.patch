+From aeeef115268b6fc23e5273c4b8b65a47bdadb566 Mon Sep 17 00:00:00 2001
+From: adiga <adiga@ms01>
+Date: Thu, 12 Nov 2026 02:04:36 +0300
+Subject: [PATCH 09/10] picasso: baseline - fs_mgr change from earlier sessions
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ fs_mgr/fs_mgr.c | 9 +++++++++
+ 1 file changed, 9 insertions(+)
+
+diff --git a/fs_mgr/fs_mgr.c b/fs_mgr/fs_mgr.c
+index 2add5df73..f2f0c39b0 100644
+--- a/fs_mgr/fs_mgr.c
++++ b/fs_mgr/fs_mgr.c
+@@ -38,6 +38,7 @@
+ #include <cutils/android_reboot.h>
+ #include <cutils/partition_utils.h>
+ #include <cutils/properties.h>
++#include <cutils/android_reboot.h>
+ #include <logwrap/logwrap.h>
+ #include <blkid/blkid.h>
+ 
+@@ -653,6 +654,14 @@ int fs_mgr_mount_all(struct fstab *fstab, int mount_mode)
+                        "%s at %s options: %s error: %s\n",
+                        fstab->recs[attempted_idx].blk_device, fstab->recs[attempted_idx].mount_point,
+                        fstab->recs[attempted_idx].fs_options, strerror(mount_errno));
++                /* PICASSO PORT: without /system nothing can boot; do a WARM
++                 * reboot into recovery so that ram_console (last_kmsg) with
++                 * the full boot log (incl. early mmc probe) survives and can
++                 * be dumped by the logdump zip. */
++                if (!strcmp(fstab->recs[attempted_idx].mount_point, "/system")) {
++                    ERROR("PICASSO: /system mount failed - warm reboot into recovery for logdump\n");
++                    android_reboot(ANDROID_RB_RESTART2, 0, "recovery");
++                }
+                 ++error_count;
+             }
+             continue;
+-- 
