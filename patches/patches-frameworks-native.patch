+From 90403d6ef13ab0a67c2b4faf17d9492178c6840a Mon Sep 17 00:00:00 2001
+From: zhongjie <zhongjie.shi@intel.com>
+Date: Wed, 9 Mar 2016 15:05:04 +0800
+Subject: [PATCH 05/10] Release resources when repeating dlopen-dlcose.
+
+When the libbinder.so is dlopen and dlclose many
+times, we need to delete the pthread_key and
+munmap the memory mapping.
+
+Otherwise, it will crash as the leakage causes
+the pthread_key or memory mapping surpass their
+limit.
+
+Change-Id: Ice64d4ef685c1f665350286f9e5ddf790beac236
+Signed-off-by: zhongjie <zhongjie.shi@intel.com>
+---
+ libs/binder/IPCThreadState.cpp | 1 +
+ libs/binder/ProcessState.cpp   | 7 +++++++
+ 2 files changed, 8 insertions(+)
+
+diff --git a/libs/binder/IPCThreadState.cpp b/libs/binder/IPCThreadState.cpp
+index d90798f51..9b5f0d7fc 100644
+--- a/libs/binder/IPCThreadState.cpp
++++ b/libs/binder/IPCThreadState.cpp
+@@ -330,6 +330,7 @@ void IPCThreadState::shutdown()
+             delete st;
+             pthread_setspecific(gTLS, NULL);
+         }
++        pthread_key_delete(gTLS);
+         gHaveTLS = false;
+     }
+ }
+diff --git a/libs/binder/ProcessState.cpp b/libs/binder/ProcessState.cpp
+index f13f49fe9..e45b5f1ff 100644
+--- a/libs/binder/ProcessState.cpp
++++ b/libs/binder/ProcessState.cpp
+@@ -366,6 +366,13 @@ ProcessState::ProcessState()
+ 
+ ProcessState::~ProcessState()
+ {
++    if (mDriverFD >= 0) {
++        if (mVMStart != MAP_FAILED) {
++            munmap(mVMStart, BINDER_VM_SIZE);
++        }
++        close(mDriverFD);
++    }
++    mDriverFD = -1;
+ }
+         
+ }; // namespace android
+-- 
+2.34.1
+
