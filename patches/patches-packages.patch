diff --git a/packages/apps/Browser/res/layout/suggestion_item.xml b/packages/apps/Browser/res/layout/suggestion_item.xml
new file mode 100644
index 0000000..acfa4f4
--- /dev/null
+++ b/packages/apps/Browser/res/layout/suggestion_item.xml
@@ -0,0 +1,74 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+/* //device/apps/common/assets/res/any/layout/simple_spinner_item.xml
+**
