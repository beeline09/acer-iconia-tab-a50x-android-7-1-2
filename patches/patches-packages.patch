+            BackgroundHandler.execute(new PruneThumbnails(mActivity, null));
+            if (intent == null) {
+                // This won't happen under common scenarios. The icicle is
+                // not null, but there aren't any tabs to restore.
+                openTabToHomePage();
+            } else {
