+From a9e0bb2c114c57214c0bd8b788d3a5770872da8a Mon Sep 17 00:00:00 2001
+From: adiga <adiga@ms01>
+Date: Thu, 12 Nov 2026 02:04:36 +0300
+Subject: [PATCH 15/15] bt: survive BCM4329B1 (BT 2.1, no LE) on the 7.1 stack
+
+- hci_hal_h4: the chip emits two stray bytes ("41") right after
+  HCI_VSC_DOWNLOAD_MINIDRV; skip up to 8 consecutive non-H4 bytes instead of
+  aborting, longer runs still abort (stock restart) instead of spinning.
+- controller: without LE support the BLE getters return zeroed values instead
+  of asserting (pairing with dual-mode headsets crashed the stack), and
+  set_ble_resolving_list_max_size is a no-op.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ device/src/controller.c | 24 +++++++++++++-----------
+ hci/src/hci_hal_h4.c    | 11 +++++++++++
+ 2 files changed, 24 insertions(+), 11 deletions(-)
+
+diff --git a/device/src/controller.c b/device/src/controller.c
+index 4440ea55..b49a7bcd 100644
+--- a/device/src/controller.c
++++ b/device/src/controller.c
+@@ -312,13 +312,13 @@ static uint8_t *get_local_supported_codecs(uint8_t *number_of_codecs) {
+ 
+ static const bt_device_features_t *get_features_ble(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return &features_ble;
+ }
+ 
+ static const uint8_t *get_ble_supported_states(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return ble_supported_states;
+ }
+ 
+@@ -369,19 +369,19 @@ static bool supports_ble(void) {
+ 
+ static bool supports_ble_privacy(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return HCI_LE_ENHANCED_PRIVACY_SUPPORTED(features_ble.as_array);
+ }
+ 
+ static bool supports_ble_packet_extension(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return HCI_LE_DATA_LEN_EXT_SUPPORTED(features_ble.as_array);
+ }
+ 
+ static bool supports_ble_connection_parameters_request(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return HCI_LE_CONN_PARAM_REQ_SUPPORTED(features_ble.as_array);
+ }
+ 
+@@ -392,7 +392,7 @@ static uint16_t get_acl_data_size_classic(void) {
+ 
+ static uint16_t get_acl_data_size_ble(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return acl_data_size_ble;
+ }
+ 
+@@ -408,7 +408,7 @@ static uint16_t get_acl_packet_size_ble(void) {
+ 
+ static uint16_t get_ble_suggested_default_data_length(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return ble_suggested_default_data_length;
+ }
+ 
+@@ -419,19 +419,19 @@ static uint16_t get_acl_buffer_count_classic(void) {
+ 
+ static uint8_t get_acl_buffer_count_ble(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return acl_buffer_count_ble;
+ }
+ 
+ static uint8_t get_ble_white_list_size(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return ble_white_list_size;
+ }
+ 
+ static uint8_t get_ble_resolving_list_max_size(void) {
+   assert(readable);
+-  assert(ble_supported);
++  /* PICASSO: no assert - without LE (BCM4329) the values stay zeroed */
+   return ble_resolving_list_max_size;
+ }
+ 
+@@ -441,7 +441,9 @@ static void set_ble_resolving_list_max_size(int resolving_list_max_size) {
+   if (resolving_list_max_size != 0) {
+     assert(readable);
+   }
+-  assert(ble_supported);
++  /* PICASSO: BT 2.1 controller (BCM4329) has no LE - nothing to set */
++  if (!ble_supported)
++    return;
+   ble_resolving_list_max_size = resolving_list_max_size;
+ }
+ 
+diff --git a/hci/src/hci_hal_h4.c b/hci/src/hci_hal_h4.c
+index 9c7afe53..e272c918 100644
+--- a/hci/src/hci_hal_h4.c
++++ b/hci/src/hci_hal_h4.c
+@@ -220,6 +220,8 @@ static bool stream_corrupted_during_le_scan_workaround(const uint8_t byte_read)
+   return false;
+ }
+ 
++static int stray_bytes;  // PICASSO: consecutive non-H4 bytes
++
+ // See what data is waiting, and notify the upper layer
+ static void event_uart_has_bytes(eager_reader_t *reader, UNUSED_ATTR void *context) {
+   if (stream_has_interpretation) {
+@@ -238,10 +240,19 @@ static void event_uart_has_bytes(eager_reader_t *reader, UNUSED_ATTR void *conte
+       LOG_ERROR(LOG_TAG, "%s Unknown HCI message type 0x%x (min=0x%x max=0x%x). Aborting...",
+                 __func__, type_byte, DATA_TYPE_ACL, DATA_TYPE_EVENT);
+       LOG_EVENT_INT(BT_HCI_UNKNOWN_MESSAGE_TYPE_NUM, type_byte);
++      /* PICASSO: the BCM4329B1 emits a couple of stray bytes ("41") right
++       * after HCI_VSC_DOWNLOAD_MINIDRV. Skip a short run of such bytes; a
++       * longer run means the UART is really out of sync, so abort as stock
++       * does (the stack restarts) instead of spinning on garbage. */
++      if (++stray_bytes <= 8) {
++        LOG_ERROR(LOG_TAG, "%s skipping stray byte 0x%02x (%d)", __func__, type_byte, stray_bytes);
++        return;
++      }
+       assert(false && "Unknown HCI message type");
+       return;
+     }
+ 
++    stray_bytes = 0;
+     stream_has_interpretation = true;
+     current_data_type = type_byte;
+   }
+-- 
+2.34.1
+
