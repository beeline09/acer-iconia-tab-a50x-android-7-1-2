+From b863e584f7b5ced5b87c988ee474539aba48acb7 Mon Sep 17 00:00:00 2001
+From: adiga <adiga@ms01>
+Date: Thu, 12 Nov 2026 02:06:06 +0300
+Subject: [PATCH 10/10] bootanimation: real-time I/O priority
+
+On the slow eMMC the boot animation waited ~8 s for its page-ins behind
+zygote's boot reads before reaching main().
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ cmds/bootanimation/bootanim.rc | 3 +++
+ 1 file changed, 3 insertions(+)
+
+diff --git a/cmds/bootanimation/bootanim.rc b/cmds/bootanimation/bootanim.rc
+index 7344ba74f70..e5a74071593 100644
+--- a/cmds/bootanimation/bootanim.rc
++++ b/cmds/bootanimation/bootanim.rc
+@@ -4,4 +4,7 @@ service bootanim /system/bin/bootanimation
+     group graphics audio
+     disabled
+     oneshot
++    # PICASSO: real-time I/O priority so its few page-ins are not queued
++    # behind zygote's ~130 MB boot reads (needs the cfq scheduler)
++    ioprio rt 4
+     writepid /dev/stune/top-app/tasks
+\ No newline at end of file
+-- 
+2.34.1
