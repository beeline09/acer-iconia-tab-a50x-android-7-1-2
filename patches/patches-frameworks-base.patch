+     return true;
+   }
+ 
+-  if (strcmp(propBuf, "system") == 0) {
+-    return HasSystemGid(env, javaGids);
+-  }
+-
+   if (strcmp(propBuf, "disabled") == 0) {
+     return false;
+   }
