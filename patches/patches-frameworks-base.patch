+From 8dd5f1d9c7b7bb114b2e9151b78a5e01b148d53e Mon Sep 17 00:00:00 2001
+From: adiga <adiga@ms01>
+Date: Thu, 12 Nov 2026 02:04:36 +0300
+Subject: [PATCH 09/10] bootanimation: run on GLES2 and do not cache frame
+ textures
+
+The Tegra 2 driver cannot create OpenGL ES 1.x contexts (eglCreateContext
+-> EGL_BAD_ALLOC), so the boot animation now uses an ES 2.0 context and a
+small compatibility layer (gles1_compat) that emulates glDrawTexiOES with a
+crop rect, GL_ALPHA textures and the fixed-function no-ops it uses.
+
+Caching one texture per frame of looping parts exhausts the GPU carveout
+(the kernel carveout_killer then kills SurfaceFlinger, boot loop), so frames
+are decoded on the fly into one scratch texture (kCacheFrames = false).
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ cmds/bootanimation/Android.mk        |   5 +-
+ cmds/bootanimation/BootAnimation.cpp |  44 +++++--
+ cmds/bootanimation/BootAnimation.h   |   4 +-
+ cmds/bootanimation/gles1_compat.cpp  | 186 +++++++++++++++++++++++++++
+ cmds/bootanimation/gles1_compat.h    |  54 ++++++++
+ 5 files changed, 280 insertions(+), 13 deletions(-)
+ create mode 100644 cmds/bootanimation/gles1_compat.cpp
+ create mode 100644 cmds/bootanimation/gles1_compat.h
+
+diff --git a/cmds/bootanimation/Android.mk b/cmds/bootanimation/Android.mk
+index 3a92b9e7414..bc6bee4e9c6 100644
+--- a/cmds/bootanimation/Android.mk
++++ b/cmds/bootanimation/Android.mk
+@@ -4,7 +4,8 @@ include $(CLEAR_VARS)
+ LOCAL_SRC_FILES:= \
+     bootanimation_main.cpp \
+     audioplay.cpp \
+-    BootAnimation.cpp
++    BootAnimation.cpp \
++    gles1_compat.cpp
+ 
+ LOCAL_CFLAGS += -DGL_GLEXT_PROTOTYPES -DEGL_EGLEXT_PROTOTYPES
+ 
+@@ -23,7 +24,7 @@ LOCAL_SHARED_LIBRARIES := \
+     libui \
+     libskia \
+     libEGL \
+-    libGLESv1_CM \
++    libGLESv2 \
+     libgui \
+     libOpenSLES \
+     libtinyalsa
+diff --git a/cmds/bootanimation/BootAnimation.cpp b/cmds/bootanimation/BootAnimation.cpp
+index 53e4965eccc..29f4b8d43bb 100644
+--- a/cmds/bootanimation/BootAnimation.cpp
++++ b/cmds/bootanimation/BootAnimation.cpp
+@@ -53,8 +53,7 @@
+ #include <SkImageDecoder.h>
+ #pragma GCC diagnostic pop
+ 
+-#include <GLES/gl.h>
+-#include <GLES/glext.h>
++#include "gles1_compat.h"
+ #include <EGL/eglext.h>
+ 
+ #include "BootAnimation.h"
+@@ -191,7 +190,7 @@ status_t BootAnimation::initTexture(Texture* texture, AssetManager& assets,
+     return NO_ERROR;
+ }
+ 
+-status_t BootAnimation::initTexture(FileMap* map, int* width, int* height)
++status_t BootAnimation::initTexture(FileMap* map, int* width, int* height, bool keepMap)
+ {
+     SkBitmap bitmap;
+     SkMemoryStream  stream(map->getDataPtr(), map->getDataLength());
+@@ -207,7 +206,9 @@ status_t BootAnimation::initTexture(FileMap* map, int* width, int* height)
+     // FileMap memory is never released until application exit.
+     // Release it now as the texture is already loaded and the memory used for
+     // the packed resource can be released.
+-    delete map;
++    // PICASSO: keep it when frames are re-decoded on every loop (no caching).
++    if (!keepMap)
++        delete map;
+ 
+     // ensure we can call getPixels(). No need to call unlock, since the
+     // bitmap will go out of scope when we return from this method.
+@@ -285,8 +286,12 @@ status_t BootAnimation::readyToRun() {
+             EGL_GREEN_SIZE, 8,
+             EGL_BLUE_SIZE,  8,
+             EGL_DEPTH_SIZE, 0,
++            EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+             EGL_NONE
+     };
++    // PICASSO: GLES 2.0 context (the Tegra 2 driver cannot create ES 1.x
++    // contexts); fixed-function calls are emulated by gles1_compat.
++    const EGLint contextAttribs[] = { EGL_CONTEXT_CLIENT_VERSION, 2, EGL_NONE };
+     EGLint w, h;
+     EGLint numConfigs;
+     EGLConfig config;
+@@ -298,12 +303,14 @@ status_t BootAnimation::readyToRun() {
+     eglInitialize(display, 0, 0);
+     eglChooseConfig(display, attribs, &config, 1, &numConfigs);
+     surface = eglCreateWindowSurface(display, config, s.get(), NULL);
+-    context = eglCreateContext(display, config, NULL, NULL);
++    context = eglCreateContext(display, config, NULL, contextAttribs);
+     eglQuerySurface(display, surface, EGL_WIDTH, &w);
+     eglQuerySurface(display, surface, EGL_HEIGHT, &h);
+ 
+-    if (eglMakeCurrent(display, surface, surface, context) == EGL_FALSE)
++    if (eglMakeCurrent(display, surface, surface, context) == EGL_FALSE) {
++        ALOGE("eglMakeCurrent failed: 0x%x", eglGetError());
+         return NO_INIT;
++    }
+ 
+     mDisplay = display;
+     mContext = context;
+@@ -872,6 +879,11 @@ bool BootAnimation::movie()
+ 
+ bool BootAnimation::playAnimation(const Animation& animation)
+ {
++    // PICASSO: caching one texture per frame of looping parts exhausts the
++    // Tegra 2 GPU carveout (the kernel carveout_killer then kills
++    // SurfaceFlinger), so frames are decoded on the fly instead.
++    static const bool kCacheFrames = false;
++    GLuint scratchTex = 0;
+     const size_t pcount = animation.parts.size();
+     nsecs_t frameDuration = s2ns(1) / animation.fps;
+     const int animationX = (mWidth - animation.width) / 2;
+@@ -911,9 +923,9 @@ bool BootAnimation::playAnimation(const Animation& animation)
+                 const Animation::Frame& frame(part.frames[j]);
+                 nsecs_t lastFrame = systemTime();
+ 
+-                if (r > 0) {
++                if (kCacheFrames && r > 0) {
+                     glBindTexture(GL_TEXTURE_2D, frame.tid);
+-                } else {
++                } else if (kCacheFrames) {
+                     if (part.count != 1) {
+                         glGenTextures(1, &frame.tid);
+                         glBindTexture(GL_TEXTURE_2D, frame.tid);
+@@ -922,6 +934,17 @@ bool BootAnimation::playAnimation(const Animation& animation)
+                     }
+                     int w, h;
+                     initTexture(frame.map, &w, &h);
++                } else {
++                    // PICASSO: decode every frame into one scratch texture.
++                    if (scratchTex == 0) {
++                        glGenTextures(1, &scratchTex);
++                        glBindTexture(GL_TEXTURE_2D, scratchTex);
++                        glTexParameterx(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
++                        glTexParameterx(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
++                    }
++                    glBindTexture(GL_TEXTURE_2D, scratchTex);
++                    int w, h;
++                    initTexture(frame.map, &w, &h, true /* keepMap */);
+                 }
+ 
+                 const int xc = animationX + frame.trimX;
+@@ -978,7 +1001,7 @@ bool BootAnimation::playAnimation(const Animation& animation)
+ 
+     // Free textures created for looping parts now that the animation is done.
+     for (const Animation::Part& part : animation.parts) {
