+From 90403d6ef13ab0a67c2b4faf17d9492178c6840a Mon Sep 17 00:00:00 2001
+From: zhongjie <zhongjie.shi@intel.com>
+Date: Wed, 9 Mar 2016 15:05:04 +0800
+Subject: [PATCH 05/10] Release resources when repeating dlopen-dlcose.
+
+When the libbinder.so is dlopen and dlclose many
+times, we need to delete the pthread_key and
+munmap the memory mapping.
+
+Otherwise, it will crash as the leakage causes
+the pthread_key or memory mapping surpass their
+limit.
+
+Change-Id: Ice64d4ef685c1f665350286f9e5ddf790beac236
+Signed-off-by: zhongjie <zhongjie.shi@intel.com>
+---
+ libs/binder/IPCThreadState.cpp | 1 +
+ libs/binder/ProcessState.cpp   | 7 +++++++
+ 2 files changed, 8 insertions(+)
+
+diff --git a/libs/binder/IPCThreadState.cpp b/libs/binder/IPCThreadState.cpp
+index d90798f51..9b5f0d7fc 100644
+--- a/libs/binder/IPCThreadState.cpp
++++ b/libs/binder/IPCThreadState.cpp
+@@ -330,6 +330,7 @@ void IPCThreadState::shutdown()
+             delete st;
+             pthread_setspecific(gTLS, NULL);
+         }
++        pthread_key_delete(gTLS);
+         gHaveTLS = false;
+     }
+ }
+diff --git a/libs/binder/ProcessState.cpp b/libs/binder/ProcessState.cpp
+index f13f49fe9..e45b5f1ff 100644
+--- a/libs/binder/ProcessState.cpp
++++ b/libs/binder/ProcessState.cpp
+@@ -366,6 +366,13 @@ ProcessState::ProcessState()
+ 
+ ProcessState::~ProcessState()
+ {
++    if (mDriverFD >= 0) {
++        if (mVMStart != MAP_FAILED) {
++            munmap(mVMStart, BINDER_VM_SIZE);
++        }
++        close(mDriverFD);
++    }
++    mDriverFD = -1;
+ }
+         
+ }; // namespace android
+-- 
+2.34.1
+
+
+From bd8bb84c5a1e5f7a8b0d1bdb5b3300530e6ccf76 Mon Sep 17 00:00:00 2001
+From: Jake Weinstein <xboxlover360@gmail.com>
+Date: Wed, 8 Feb 2017 19:48:52 -0500
+Subject: [PATCH 06/10] SF: Improve phase/vsync offsets on HWC1
+
+On HWC2, SurfaceFlinger races against hardware vsync
+on untuned video-mode panels, which can result in a
+significant number of dropped frames.
+HWC1 does not have this issue, so set the offsets
+to 1ms on HWC2 and 0ms for HWC1.
+
+Test: mm -j32
+
+Change-Id: I8ea170667e1144f8f21d46ea2202ab7d4a5f4382
+Signed-off-by: Alex Naidis <alex.naidis@linux.com>
+---
+ services/surfaceflinger/Android.mk | 16 ++++++++++++++--
+ 1 file changed, 14 insertions(+), 2 deletions(-)
+
+diff --git a/services/surfaceflinger/Android.mk b/services/surfaceflinger/Android.mk
+index 2cd221aab..ba9614623 100644
+--- a/services/surfaceflinger/Android.mk
++++ b/services/surfaceflinger/Android.mk
+@@ -103,16 +103,28 @@ endif
+ # [1] https://developer.android.com/studio/profile/systrace.html
+ # [2] https://developer.android.com/training/testing/performance.html
+ 
++# On HWC2, SurfaceFlinger races against hardware vsync
++# on untuned video-mode panels, which can result in a significant number of dropped frames.
++# HWC1 does not have this issue, so set the offsets to 1ms on HWC2 and 0ms for HWC1.
++
+ ifneq ($(VSYNC_EVENT_PHASE_OFFSET_NS),)
+     LOCAL_CFLAGS += -DVSYNC_EVENT_PHASE_OFFSET_NS=$(VSYNC_EVENT_PHASE_OFFSET_NS)
+ else
+-    LOCAL_CFLAGS += -DVSYNC_EVENT_PHASE_OFFSET_NS=1000000
++    ifeq ($(TARGET_USES_HWC2),true)
++        LOCAL_CFLAGS += -DVSYNC_EVENT_PHASE_OFFSET_NS=1000000
++    else
++        LOCAL_CFLAGS += -DVSYNC_EVENT_PHASE_OFFSET_NS=0
++    endif
+ endif
+ 
+ ifneq ($(SF_VSYNC_EVENT_PHASE_OFFSET_NS),)
+     LOCAL_CFLAGS += -DSF_VSYNC_EVENT_PHASE_OFFSET_NS=$(SF_VSYNC_EVENT_PHASE_OFFSET_NS)
+ else
+-    LOCAL_CFLAGS += -DSF_VSYNC_EVENT_PHASE_OFFSET_NS=1000000
++    ifeq ($(TARGET_USES_HWC2),true)
++        LOCAL_CFLAGS += -DSF_VSYNC_EVENT_PHASE_OFFSET_NS=1000000
++    else
++        LOCAL_CFLAGS += -DSF_VSYNC_EVENT_PHASE_OFFSET_NS=0
++    endif
+ endif
+ 
+ ifneq ($(PRESENT_TIME_OFFSET_FROM_VSYNC_NS),)
+-- 
+2.34.1
+
