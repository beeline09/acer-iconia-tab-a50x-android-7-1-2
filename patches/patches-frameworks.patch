diff --git a/frameworks/base/cmds/bootanimation/gles1_compat.cpp b/frameworks/base/cmds/bootanimation/gles1_compat.cpp
new file mode 100644
index 0000000..12e2dbf
--- /dev/null
+++ b/frameworks/base/cmds/bootanimation/gles1_compat.cpp
@@ -0,0 +1,186 @@
+/*
+ * PICASSO: GLES1-on-GLES2 compatibility layer for BootAnimation (see header).
+ */
+#define LOG_TAG "BootAnimation"
+
+#include <map>
+
+#include <GLES2/gl2.h>
+#include <utils/Log.h>
+
+#include "gles1_compat.h"
+
+// Call the real GLES2 entry points from here.
+#undef glBindTexture
+#undef glDeleteTextures
+#undef glTexImage2D
+#undef glTexParameteriv
+#undef glTexParameterx
+#undef glEnable
+#undef glDisable
+#undef glDrawTexiOES
+
+namespace android {
+namespace gles1compat {
+
+struct TexInfo {
+    GLsizei w = 0, h = 0;     // allocated texture size
+    bool alphaOnly = false;   // GL_ALPHA texture (clock font)
+    GLint crop[4] = {0, 0, 0, 0};
+};
+
+static std::map<GLuint, TexInfo> sTextures;
+static GLuint sBound = 0;
+static GLuint sProgram = 0;
+static GLint sPosLoc = -1, sTexLoc = -1, sSamplerLoc = -1, sAlphaLoc = -1;
+
+static const char kVertexShader[] =
+        "attribute vec2 aPos;\n"
+        "attribute vec2 aTex;\n"
+        "varying vec2 vTex;\n"
+        "void main() {\n"
+        "  vTex = aTex;\n"
+        "  gl_Position = vec4(aPos, 0.0, 1.0);\n"
+        "}\n";
+
+// GL_REPLACE semantics: RGB(A) textures output the texel, GL_ALPHA textures
+// output the current colour (white) with the texel alpha.
+static const char kFragmentShader[] =
+        "precision mediump float;\n"
+        "uniform sampler2D uTex;\n"
+        "uniform float uAlphaOnly;\n"
+        "varying vec2 vTex;\n"
+        "void main() {\n"
+        "  vec4 c = texture2D(uTex, vTex);\n"
+        "  gl_FragColor = mix(c, vec4(1.0, 1.0, 1.0, c.a), uAlphaOnly);\n"
+        "}\n";
+
+static GLuint compile(GLenum type, const char* src) {
+    GLuint s = glCreateShader(type);
+    glShaderSource(s, 1, &src, nullptr);
+    glCompileShader(s);
+    GLint ok = 0;
+    glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[512] = {0};
+        glGetShaderInfoLog(s, sizeof(log) - 1, nullptr, log);
+        ALOGE("gles1compat: shader compile failed: %s", log);
+        glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+static bool ensureProgram() {
+    if (sProgram) return true;
+    GLuint vs = compile(GL_VERTEX_SHADER, kVertexShader);
+    GLuint fs = compile(GL_FRAGMENT_SHADER, kFragmentShader);
+    if (!vs || !fs) return false;
+    GLuint p = glCreateProgram();
+    glAttachShader(p, vs);
+    glAttachShader(p, fs);
+    glLinkProgram(p);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(p, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        ALOGE("gles1compat: program link failed");
+        glDeleteProgram(p);
+        return false;
+    }
+    sProgram = p;
+    sPosLoc = glGetAttribLocation(p, "aPos");
+    sTexLoc = glGetAttribLocation(p, "aTex");
+    sSamplerLoc = glGetUniformLocation(p, "uTex");
+    sAlphaLoc = glGetUniformLocation(p, "uAlphaOnly");
+    ALOGI("gles1compat: GLES2 textured-quad program ready");
+    return true;
+}
+
+void bindTexture(GLenum target, GLuint name) {
+    if (target == GL_TEXTURE_2D) sBound = name;
+    glBindTexture(target, name);
+}
+
+void deleteTextures(GLsizei n, const GLuint* names) {
+    for (GLsizei i = 0; i < n; i++) {
+        sTextures.erase(names[i]);
+        if (names[i] == sBound) sBound = 0;
+    }
+    glDeleteTextures(n, names);
+}
+
+void texImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width,
+        GLsizei height, GLint border, GLenum format, GLenum type, const void* pixels) {
+    if (target == GL_TEXTURE_2D && level == 0) {
+        TexInfo& t = sTextures[sBound];
+        t.w = width;
+        t.h = height;
+        t.alphaOnly = (format == GL_ALPHA);
+    }
+    glTexImage2D(target, level, internalformat, width, height, border, format, type, pixels);
+}
+
+void texParameteriv(GLenum target, GLenum pname, const GLint* params) {
+    if (pname == GL_TEXTURE_CROP_RECT_OES) {
+        TexInfo& t = sTextures[sBound];
+        for (int i = 0; i < 4; i++) t.crop[i] = params[i];
+        return;
+    }
+    glTexParameteriv(target, pname, params);
+}
+
+void texParameteri(GLenum target, GLenum pname, GLint param) {
+    // GLES2 non-power-of-two textures are incomplete with GL_REPEAT; the boot
+    // animation never relies on wrapping (it always draws its crop rect).
+    if ((pname == GL_TEXTURE_WRAP_S || pname == GL_TEXTURE_WRAP_T) && param == GL_REPEAT)
+        param = GL_CLAMP_TO_EDGE;
+    glTexParameteri(target, pname, param);
+}
+
+void enable(GLenum cap) {
+    if (cap != GL_TEXTURE_2D) glEnable(cap);
+}
+
+void disable(GLenum cap) {
+    if (cap != GL_TEXTURE_2D) glDisable(cap);
+}
+
+void drawTexi(GLint x, GLint y, GLint /*z*/, GLint width, GLint height) {
+    auto it = sTextures.find(sBound);
+    if (it == sTextures.end() || it->second.w <= 0 || it->second.h <= 0) return;
+    if (!ensureProgram()) return;
+    const TexInfo& t = it->second;
+
+    GLint vp[4] = {0, 0, 1, 1};
+    glGetIntegerv(GL_VIEWPORT, vp);
+    if (vp[2] <= 0 || vp[3] <= 0) return;
+
+    const float x0 = 2.0f * (x - vp[0]) / vp[2] - 1.0f;
+    const float y0 = 2.0f * (y - vp[1]) / vp[3] - 1.0f;
+    const float x1 = 2.0f * (x + width - vp[0]) / vp[2] - 1.0f;
+    const float y1 = 2.0f * (y + height - vp[1]) / vp[3] - 1.0f;
+    const float u0 = float(t.crop[0]) / t.w;
+    const float v0 = float(t.crop[1]) / t.h;
+    const float u1 = float(t.crop[0] + t.crop[2]) / t.w;
+    const float v1 = float(t.crop[1] + t.crop[3]) / t.h;
+
+    const GLfloat pos[8] = { x0, y0,  x1, y0,  x0, y1,  x1, y1 };
+    const GLfloat tex[8] = { u0, v0,  u1, v0,  u0, v1,  u1, v1 };
+
+    glUseProgram(sProgram);
+    glActiveTexture(GL_TEXTURE0);
+    glUniform1i(sSamplerLoc, 0);
+    glUniform1f(sAlphaLoc, t.alphaOnly ? 1.0f : 0.0f);
+    glVertexAttribPointer(sPosLoc, 2, GL_FLOAT, GL_FALSE, 0, pos);
+    glVertexAttribPointer(sTexLoc, 2, GL_FLOAT, GL_FALSE, 0, tex);
+    glEnableVertexAttribArray(sPosLoc);
+    glEnableVertexAttribArray(sTexLoc);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(sPosLoc);
+    glDisableVertexAttribArray(sTexLoc);
+}
+
+} // namespace gles1compat
+} // namespace android
diff --git a/frameworks/base/cmds/bootanimation/gles1_compat.h b/frameworks/base/cmds/bootanimation/gles1_compat.h
new file mode 100644
index 0000000..716fbfa
--- /dev/null
+++ b/frameworks/base/cmds/bootanimation/gles1_compat.h
@@ -0,0 +1,54 @@
+/*
+ * PICASSO: minimal GLES1-on-GLES2 compatibility layer for BootAnimation.
+ *
+ * The Tegra 2 driver on Acer A500/A501 refuses to create OpenGL ES 1.x
+ * contexts (eglCreateContext -> EGL_BAD_ALLOC), while ES 2.0 works. The boot
+ * animation only uses a handful of fixed-function calls (glDrawTexiOES with a
+ * crop rectangle, texture environment REPLACE), so they are emulated here with
+ * a single textured-quad shader. Include this instead of <GLES/gl.h>.
+ */
+#ifndef ANDROID_BOOTANIMATION_GLES1_COMPAT_H
+#define ANDROID_BOOTANIMATION_GLES1_COMPAT_H
+
+#include <GLES2/gl2.h>
+#include <GLES2/gl2ext.h>
+
+#ifndef GL_TEXTURE_CROP_RECT_OES
+#define GL_TEXTURE_CROP_RECT_OES 0x8B9D
+#endif
+#ifndef GL_TEXTURE_ENV
+#define GL_TEXTURE_ENV 0x2300
+#endif
+#ifndef GL_TEXTURE_ENV_MODE
+#define GL_TEXTURE_ENV_MODE 0x2200
+#endif
+#ifndef GL_FLAT
+#define GL_FLAT 0x1D00
+#endif
+
+namespace android {
+namespace gles1compat {
+void bindTexture(GLenum target, GLuint name);
+void deleteTextures(GLsizei n, const GLuint* names);
+void texImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width,
+        GLsizei height, GLint border, GLenum format, GLenum type, const void* pixels);
+void texParameteriv(GLenum target, GLenum pname, const GLint* params);
+void texParameteri(GLenum target, GLenum pname, GLint param);
+void enable(GLenum cap);
+void disable(GLenum cap);
+void drawTexi(GLint x, GLint y, GLint z, GLint width, GLint height);
+} // namespace gles1compat
+} // namespace android
+
+#define glBindTexture       android::gles1compat::bindTexture
+#define glDeleteTextures    android::gles1compat::deleteTextures
+#define glTexImage2D        android::gles1compat::texImage2D
+#define glTexParameteriv    android::gles1compat::texParameteriv
+#define glTexParameterx     android::gles1compat::texParameteri
+#define glEnable            android::gles1compat::enable
+#define glDisable           android::gles1compat::disable
+#define glDrawTexiOES       android::gles1compat::drawTexi
+#define glTexEnvx(t, p, v)  ((void)0)
+#define glShadeModel(m)     ((void)0)
+
+#endif // ANDROID_BOOTANIMATION_GLES1_COMPAT_H
