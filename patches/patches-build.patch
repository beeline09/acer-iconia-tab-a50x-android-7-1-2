+
+package kati
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestWordBuffer(t *testing.T) {
+	for _, tc := range []struct {
+		in   []string
+		want []string
+	}{
+		{
+			in:   []string{"foo"},
+			want: []string{"foo"},
+		},
+		{
+			in:   []string{"foo bar"},
+			want: []string{"foo", "bar"},
+		},
+		{
+			in:   []string{"  foo bar\tbaz "},
+			want: []string{"foo", "bar", "baz"},
+		},
+		{
+			in:   []string{"foo", "bar"},
+			want: []string{"foobar"},
+		},
+		{
+			in:   []string{"foo ", "bar"},
+			want: []string{"foo", "bar"},
+		},
+		{
+			in:   []string{"foo", " bar"},
+			want: []string{"foo", "bar"},
+		},
+		{
+			in:   []string{"foo ", " bar"},
+			want: []string{"foo", "bar"},
+		},
+	} {
+		var wb wordBuffer
+		for _, s := range tc.in {
+			wb.Write([]byte(s))
+		}
+
+		var got []string
+		for _, word := range wb.words {
+			got = append(got, string(word))
+		}
+		if !reflect.DeepEqual(got, tc.want) {
+			t.Errorf("%q => %q; want %q", tc.in, got, tc.want)
+		}
+	}
+}
