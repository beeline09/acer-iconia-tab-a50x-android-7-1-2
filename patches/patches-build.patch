+					},
+				},
+			},
+		},
+		{
+			in: `${shell echo '()'}`,
+			val: &funcShell{
+				fclosure: fclosure{
+					args: []Value{
+						literal("{shell"),
+						literal("echo '()'"),
+					},
+				},
+			},
+		},
+		{
+			in: `$(shell echo ')')`,
+			val: expr{
+				&funcShell{
+					fclosure: fclosure{
+						args: []Value{
+							literal("(shell"),
+							literal("echo '"),
+						},
+					},
+				},
+				literal("')"),
+			},
+		},
+		{
+			in: `${shell echo ')'}`,
+			val: &funcShell{
+				fclosure: fclosure{
+					args: []Value{
+						literal("{shell"),
+						literal("echo ')'"),
+					},
+				},
+			},
+		},
+		{
+			in: `${shell echo '}'}`,
+			val: expr{
+				&funcShell{
+					fclosure: fclosure{
+						args: []Value{
+							literal("{shell"),
