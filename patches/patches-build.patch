+func (r *builtinRule) isArg(argName string) bool {
+	return false
+}
+
+func (r *builtinRule) String() string {
+	return "<builtin>:" + r.name_
+}
+
+func (p *packageContext) AddNinjaFileDeps(deps ...string) {
+	p.ninjaFileDeps = append(p.ninjaFileDeps, deps...)
+}
