+		var testType string
+
+		if testCase.prepend {
+			testType = "prepend"
+			err = PrependProperties(got, testCase.in2, testCase.filter)
+		} else {
+			testType = "append"
+			err = AppendProperties(got, testCase.in2, testCase.filter)
+		}
+
+		check(t, testType, testString, got, err, testCase.out, testCase.err)
+	}
+}
