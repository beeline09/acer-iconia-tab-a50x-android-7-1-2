+			continue
+		}
+		if got, want := val, tc.val; !reflect.DeepEqual(got, want) {
+			t.Errorf("parseExpr(%[1]q)=%[2]q %#[2]v, _, _;\n want %[3]q %#[3]v, _, _", tc.in, got, want)
+		}
+	}
+}
