+func BenchmarkFuncStrip(b *testing.B) {
+	strip := &funcStrip{
+		fclosure: fclosure{
+			args: []Value{
+				literal("(strip"),
+				literal("a b  c "),
+			},
+		},
+	}
+	ev := NewEvaluator(make(map[string]Var))
+	var buf evalBuffer
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		buf.Reset()
+		strip.Eval(&buf, ev)
+	}
+}
