+++ b/build/blueprint/.travis.yml
@@ -0,0 +1,24 @@
+language: go
+
+go:
+    - 1.5.1
+
+cache:
+    directories:
+        - $HOME/ninjabin
+
+install:
+    - ./.travis.install-ninja.sh
+    - export PATH=$PATH:~/ninjabin
+
+before_script:
+    - source .travis.fix-fork.sh
+
+script:
+    - go test ./...
+    - mkdir stage
+    - cd stage
+    - ../bootstrap.bash
+    - ./blueprint.bash
+    - diff -us ../build.ninja.in .bootstrap/bootstrap.ninja.in
+    - ../tests/test.sh
