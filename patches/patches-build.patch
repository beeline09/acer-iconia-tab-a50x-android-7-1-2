+func TestAppendProperties(t *testing.T) {
+	for _, testCase := range appendPropertiesTestCases {
+		testString := fmt.Sprintf("%v, %v -> %v", testCase.in1, testCase.in2, testCase.out)
+
+		got := testCase.in1
