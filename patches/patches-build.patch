+touch dir1/file1 dir2/file2
+ln -s ../../dir1 linkdir/d/link
+build
+
+sleep_if_necessary 1
+touch dir1/file1_2
+build
+
+rm linkdir/d/link
+ln -s ../../dir2 linkdir/d/link
+build
